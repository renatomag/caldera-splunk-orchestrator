# Copy this file to .env and fill in the values, then:
#   source .env
# Or export each variable individually before running the orchestrator.
#
# NEVER commit .env or settings.yaml with real credentials to git.

CALDERA_API_KEY=your-caldera-api-key-here
SPLUNK_TOKEN=your-splunk-api-token-here
GOVC_USERNAME=your-vcenter-username-here
GOVC_PASSWORD=your-vcenter-password-here
